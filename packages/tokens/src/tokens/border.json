{
  "_meta": {
    "description": "Border token system — border radii and border widths"
  },

  "radius": {
    "none":   "0px",
    "xs":     "2px",
    "sm":     "4px",
    "md":     "6px",
    "lg":     "8px",
    "xl":     "12px",
    "2xl":    "16px",
    "3xl":    "24px",
    "4xl":    "32px",
    "full":   "9999px"
  },

  "width": {
    "none":       "0px",
    "hairline":   "0.5px",
    "thin":       "1px",
    "base":       "1.5px",
    "medium":     "2px",
    "thick":      "4px"
  },

  "style": {
    "solid":  "solid",
    "dashed": "dashed",
    "dotted": "dotted",
    "double": "double",
    "none":   "none"
  },

  "composite": {
    "default":   "1px solid",
    "subtle":    "1px dashed",
    "strong":    "2px solid",
    "focus":     "2px solid",
    "error":     "1.5px solid",
    "card":      "1px solid",
    "separator": "1px solid",
    "divider":   "1px solid"
  },

  "outline": {
    "focus": {
      "width":  "{width.medium}",
      "style":  "{style.solid}",
      "offset": "2px"
    },
    "focusInset": {
      "width":  "{width.medium}",
      "style":  "{style.solid}",
      "offset": "-2px"
    }
  }
}
