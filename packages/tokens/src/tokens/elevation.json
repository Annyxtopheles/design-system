      "description": "Tooltips, popups, autocomplete menus"
    },
    "8": {
      "level":       8,
      "name":        "dropdown",
      "boxShadow":   "0px 12px 30px rgba(15, 23, 42, 0.12), 0px 24px 48px rgba(15, 23, 42, 0.16), inset 0 1px 0 rgba(255, 255, 255, 1.0)",
      "description": "Dropdown menus, context menus, select panels"
    },
    "9": {
      "level":       9,
      "name":        "drawer",
      "boxShadow":   "0px 16px 40px rgba(15, 23, 42, 0.14), 0px 32px 64px rgba(15, 23, 42, 0.18), inset 0 1px 0 rgba(255, 255, 255, 1.0)",
      "description": "Side drawers, slide-over panels"
    },
    "10": {
      "level":       10,
      "name":        "modal",
      "boxShadow":   "0px 20px 60px rgba(15, 23, 42, 0.18), 0px 40px 80px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 1.0)",
      "description": "Modal dialogs, full-screen overlays"
    },
    "11": {
      "level":       11,
