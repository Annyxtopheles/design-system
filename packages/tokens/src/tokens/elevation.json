{
  "_meta": {
    "description": "Elevation shadow system — 12 levels (0=flat, 11=maximum overlay) with ambient, direct, and rim-light layers per theme",
    "model": "Each level composes: 1 ambient (large-spread, low-opacity) + 1 direct (tight-offset, higher-opacity) + rim-light (levels 4+)",
    "themes": ["light", "dark", "cosmic-neon"]
  },

  "light": {
    "0": {
      "level":       0,
      "name":        "flat",
      "boxShadow":   "none",
      "description": "No elevation — flush to background surface"
    },
    "1": {
      "level":       1,
      "name":        "minimal",
      "boxShadow":   "0px 1px 2px rgba(15, 23, 42, 0.04), 0px 1px 3px rgba(15, 23, 42, 0.10)",
      "description": "Subtle card lift — form inputs, tags, chips"
    },
    "2": {
      "level":       2,
      "name":        "low",
      "boxShadow":   "0px 1px 4px rgba(15, 23, 42, 0.05), 0px 2px 6px rgba(15, 23, 42, 0.10)",
      "description": "Cards, tiles, list items — resting state"
    },
    "3": {
      "level":       3,
      "name":        "raised",
      "boxShadow":   "0px 2px 6px rgba(15, 23, 42, 0.06), 0px 4px 12px rgba(15, 23, 42, 0.10)",
      "description": "Cards hover state, floating labels"
    },
    "4": {
      "level":       4,
      "name":        "floating",
      "boxShadow":   "0px 4px 10px rgba(15, 23, 42, 0.07), 0px 8px 20px rgba(15, 23, 42, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.80)",
      "description": "Floating action buttons, dropdowns — rim begins"
    },
    "5": {
      "level":       5,
      "name":        "elevated",
      "boxShadow":   "0px 6px 14px rgba(15, 23, 42, 0.08), 0px 12px 28px rgba(15, 23, 42, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.90)",
      "description": "Sticky headers, elevated nav bars"
    },
    "6": {
      "level":       6,
      "name":        "sticky",
      "boxShadow":   "0px 8px 18px rgba(15, 23, 42, 0.09), 0px 16px 32px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.95)",
      "description": "Sticky positioned elements, focus rings on cards"
    },
    "7": {
      "level":       7,
      "name":        "popup",
