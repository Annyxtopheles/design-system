node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
.next/
out/
dist/
compiled/
*.tsbuildinfo

# ── Design token dist/ is INTENTIONALLY committed ──────────────────────────────
